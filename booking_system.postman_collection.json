        {
          "name": "Customer - Booking (requires customer token)",
          "item": [
            {
              "name": "Create booking (idempotent)",
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"categoryId\": 1,\n  \"quantity\": 2,\n  \"voucherCode\": \"FLASH10\",\n  \"idempotencyKey\": \"uuid-123456\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/bookings",
                  "host": ["{{base_url}}"],
                  "path": ["api", "bookings"]
                }
              }
            },
            {
              "name": "Cancel a booking",
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reason\": \"Changed my mind\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/bookings/1/cancel",
                  "host": ["{{base_url}}"],
                  "path": ["api", "bookings", "1", "cancel"]
                }
              }
            },
            {
              "name": "Get booking by ID",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/bookings/1",
                  "host": ["{{base_url}}"],
                  "path": ["api", "bookings", "1"]
                }
              }
            },
            {
              "name": "Get my bookings",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/bookings/user",
                  "host": ["{{base_url}}"],
                  "path": ["api", "bookings", "user"]
                }
              }
            }
          ]
        },
