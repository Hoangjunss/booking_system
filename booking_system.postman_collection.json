{
  "info": {
    "name": "Concert Booking Platform API",
    "description": "Complete API collection with normal and error test cases (separate tokens for admin and customer)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Normal Cases",
      "item": [
        {
          "name": "Authentication",
          "item": [
            {
              "name": "Register (create new customer)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    console.log('User registered:', pm.response.json().email);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"newcustomer@example.com\",\n  \"name\": \"New Customer\",\n  \"password\": \"123456\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/register",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "register"]
                }
              }
            },
            {
              "name": "Login as Admin",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const jsonData = pm.response.json();",
                      "if (jsonData.accessToken) {",
                      "    pm.collectionVariables.set(\"adminToken\", jsonData.accessToken);",
                      "    pm.collectionVariables.set(\"adminRefreshToken\", jsonData.refreshToken);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@geek.com\",\n  \"password\": \"admin123\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/login",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "login"]
                }
              }
            },
            {
              "name": "Login as Customer",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const jsonData = pm.response.json();",
                      "if (jsonData.accessToken) {",
                      "    pm.collectionVariables.set(\"customerToken\", jsonData.accessToken);",
                      "    pm.collectionVariables.set(\"customerRefreshToken\", jsonData.refreshToken);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"customer123\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/login",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "login"]
                }
              }
            },
            {
              "name": "Refresh Admin Token",
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/refresh",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "refresh"]
                }
              }
            },
            {
              "name": "Refresh Customer Token",
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{customerRefreshToken}}\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/refresh",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "refresh"]
                }
              }
            }
          ]
        },
        {
          "name": "Customer - Public",
          "item": [
            {
              "name": "Get all published concerts",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/concerts",
                  "host": ["{{base_url}}"],
                  "path": ["api", "concerts"]
                }
              }
            },
            {
              "name": "Get concert details by ID",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/concerts/1",
                  "host": ["{{base_url}}"],
                  "path": ["api", "concerts", "1"]
                }
              }
            },
            {
              "name": "Get ticket categories of a concert",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/concerts/1/ticket-categories",
