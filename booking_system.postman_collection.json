{
  "info": {
    "name": "Concert Booking Platform API",
    "description": "Complete API collection with normal and error test cases (separate tokens for admin and customer).\n\n**Key points:**\n- Booking requests use `items` array, each with `ticketCategoryId` and `quantity`.\n- `idempotencyKey` must be a unique UUID per request; duplicates return existing booking + `duplicate: true` flag.\n- Admin endpoints require `ADMIN` role.\n- Concerts must be `PUBLISHED` to be bookable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Normal Cases",
      "item": [
        {
          "name": "Authentication",
          "description": "Endpoints for user registration, login, and token refresh.",
          "item": [
            {
              "name": "Register (create new customer)",
              "description": "Creates a new user with role `CUSTOMER`. Passwords are hashed with BCrypt.\n\n**Request body:**\n- `email`: valid email\n- `name`: display name\n- `password`: at least 8 characters",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    console.log('User registered:', pm.response.json().email);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"newcustomer@example.com\",\n  \"name\": \"New Customer\",\n  \"password\": \"12345678\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/register",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "register"]
                }
              }
            },
            {
              "name": "Login as Admin",
              "description": "Login with seeded admin account (see `sql/seed.sql`). Stores `adminToken` and `adminRefreshToken` in collection variables.",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const jsonData = pm.response.json();",
                      "if (jsonData.accessToken) {",
                      "    pm.collectionVariables.set(\"adminToken\", jsonData.accessToken);",
                      "    pm.collectionVariables.set(\"adminRefreshToken\", jsonData.refreshToken);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@geek.com\",\n  \"password\": \"admingeel\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/login",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "login"]
                }
              }
            },
            {
              "name": "Login as Customer (seed customer)",
              "description": "Login with seeded customer (from `seed.sql`). Stores `customerToken` and `customerRefreshToken`.",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const jsonData = pm.response.json();",
                      "if (jsonData.accessToken) {",
                      "    pm.collectionVariables.set(\"customerToken\", jsonData.accessToken);",
                      "    pm.collectionVariables.set(\"customerRefreshToken\", jsonData.refreshToken);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"customer1@example.com\",\n  \"password\": \"customergeek\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/login",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "login"]
                }
              }
            },
            {
              "name": "Refresh Admin Token",
              "description": "Use a valid refresh token to obtain a new access token. The refresh token remains valid (no blacklist).",
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/refresh",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "refresh"]
                }
              }
            },
            {
              "name": "Refresh Customer Token",
              "description": "Refresh customer access token.",
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{customerRefreshToken}}\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/auth/refresh",
                  "host": ["{{base_url}}"],
                  "path": ["api", "auth", "refresh"]
                }
              }
            }
          ]
        },
        {
          "name": "Customer - Public (No Auth)",
          "description": "Public endpoints that do not require authentication.",
          "item": [
            {
              "name": "Get all published concerts",
              "description": "Returns list of concerts with status `PUBLISHED`. Data may be cached (Redis TTL 5 mins).",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/concerts",
                  "host": ["{{base_url}}"],
                  "path": ["api", "concerts"]
                }
              }
            },
            {
              "name": "Get concert details by ID",
              "description": "Returns full concert details, including ticket categories (price + available quantity).",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/concerts/1",
                  "host": ["{{base_url}}"],
                  "path": ["api", "concerts", "1"]
                }
              }
            },
            {
              "name": "Get ticket categories of a concert",
              "description": "Returns only the ticket categories for a given concert.",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/concerts/1/ticket-categories",
                  "host": ["{{base_url}}"],
                  "path": ["api", "concerts", "1", "ticket-categories"]
                }
              }
            }
          ]
        },
        {
          "name": "Customer - Booking (requires customer token)",
          "description": "Booking operations require customer authentication token.",
          "item": [
            {
              "name": "Create booking (single item)",
              "description": "Creates a booking for **one** ticket category.\n\n**Request body:**\n- `items`: array of objects\n  - `ticketCategoryId`: ID of ticket category (e.g., 1,2,3)\n  - `quantity`: number of tickets (>=1)\n- `voucherCode`: optional (e.g., \"FLASH10\")\n- `idempotencyKey`: **required** – a unique UUID to prevent duplicate requests.\n\n**Response:**\n- `bookingResponse`: details of the booking (including `items`)\n- `duplicate`: `false` for first request, `true` if same key used again (no new booking created).\n\n**Example:**\n```json\n{\n  \"items\": [{\"ticketCategoryId\": 1, \"quantity\": 2}],\n  \"voucherCode\": \"FLASH10\",\n  \"idempotencyKey\": \"uuid-single-123\"\n}\n```",
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"items\": [\n    { \"ticketCategoryId\": 1, \"quantity\": 2 }\n  ],\n  \"voucherCode\": \"FLASH10\",\n  \"idempotencyKey\": \"uuid-single-123\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/bookings",
                  "host": ["{{base_url}}"],
                  "path": ["api", "bookings"]
                }
              }
            },
            {
              "name": "Create booking (multiple items - same concert)",
              "description": "Creates a booking with **multiple ticket categories** (all must belong to the same concert). The total price is summed before voucher discount. The `items` array can have several entries.\n\n**Example:**\n```json\n{\n  \"items\": [\n    {\"ticketCategoryId\": 1, \"quantity\": 1},\n    {\"ticketCategoryId\": 2, \"quantity\": 2}\n  ],\n  \"voucherCode\": \"FIXED20\",\n  \"idempotencyKey\": \"uuid-multi-456\"\n}\n```",
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"items\": [\n    { \"ticketCategoryId\": 1, \"quantity\": 1 },\n    { \"ticketCategoryId\": 2, \"quantity\": 2 }\n  ],\n  \"voucherCode\": \"FIXED20\",\n  \"idempotencyKey\": \"uuid-multi-456\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/bookings",
                  "host": ["{{base_url}}"],
                  "path": ["api", "bookings"]
                }
              }
            },
            {
              "name": "Cancel a booking",
              "description": "Cancels a `PENDING` booking (only allowed for the owner). Reserved tickets are automatically restored (trigger or manual release).",
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reason\": \"Changed my mind\"\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/bookings/1/cancel",
                  "host": ["{{base_url}}"],
                  "path": ["api", "bookings", "1", "cancel"]
                }
              }
            },
            {
              "name": "Get booking by ID",
              "description": "Retrieves a specific booking (only accessible by the owner or admin). Includes all items.",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/bookings/1",
                  "host": ["{{base_url}}"],
                  "path": ["api", "bookings", "1"]
                }
              }
            },
            {
              "name": "Get my bookings",
              "description": "Lists all bookings of the authenticated customer (basic info, items are not loaded to avoid N+1).",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/bookings/user",
                  "host": ["{{base_url}}"],
                  "path": ["api", "bookings", "user"]
                }
              }
            }
          ]
        },
        {
          "name": "Admin - Concert Management (requires admin token)",
          "description": "Admin endpoints for managing concerts.",
          "item": [
            {
              "name": "Create concert",
              "description": "Creates a new concert (status `DRAFT`). May include an array of `ticketCategories`.",
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Summer Fest\",\n  \"description\": \"Outdoor concert\",\n  \"venue\": \"Central Park\",\n  \"eventDate\": \"2025-08-10T19:00:00\",\n  \"ticketCategories\": [\n    {\"name\": \"VIP\", \"price\": 150, \"totalQuantity\": 50},\n    {\"name\": \"General\", \"price\": 45, \"totalQuantity\": 500}\n  ]\n}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/admin/concerts",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "concerts"]
                }
              }
            },
            {
              "name": "Update concert",
              "description": "Partial update of concert details (name, description, venue, event date, status).",
              "request": {
                "method": "PUT",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"name\": \"Summer Fest 2025\"}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/admin/concerts/1",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "concerts", "1"]
                }
              }
            },
            {
              "name": "Publish concert",
              "description": "Changes concert status to `PUBLISHED`, making it visible to customers.",
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/admin/concerts/1/publish",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "concerts", "1", "publish"]
                }
              }
            },
            {
              "name": "Unpublish concert",
              "description": "Changes concert status to `DRAFT`, hiding it from customers.",
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/admin/concerts/1/unpublish",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "concerts", "1", "unpublish"]
                }
              }
            },
            {
              "name": "Get all concerts (admin with filters)",
              "description": "Paginated list of all concerts (including drafts). Supports filters: name, venue, status, date range.",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/admin/concerts?name=fest&status=PUBLISHED&page=0&size=10",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "concerts"],
                  "query": [
                    {"key": "name", "value": "fest"},
                    {"key": "status", "value": "PUBLISHED"},
                    {"key": "page", "value": "0"},
                    {"key": "size", "value": "10"}
                  ]
                }
              }
            },
            {
              "name": "Get concert by ID (admin)",
              "description": "Returns concert details even if not published (admin view).",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/admin/concerts/1",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "concerts", "1"]
                }
              }
            }
          ]
        },
        {
          "name": "Admin - Ticket Category Management (requires admin token)",
          "description": "Administration of ticket categories.",
          "item": [
            {
              "name": "Create ticket category",
              "description": "Add a new ticket category to a concert (requires `concertId` query parameter).",
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"name\": \"Early Bird\", \"price\": 30, \"totalQuantity\": 200}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/admin/ticket-categories?concertId=1",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "ticket-categories"],
                  "query": [{"key": "concertId", "value": "1"}]
                }
              }
            },
            {
              "name": "Update ticket category",
              "description": "Partial update of ticket category (price, name, totalQuantity). Adjusts availableQuantity automatically.",
              "request": {
                "method": "PUT",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"price\": 35}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/admin/ticket-categories/1",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "ticket-categories", "1"]
                }
              }
            },
            {
              "name": "Get ticket categories by concert (admin)",
              "description": "Paginated, filterable list of ticket categories for a given concert.",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/admin/ticket-categories/concert/1?page=0&size=10",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "ticket-categories", "concert", "1"],
                  "query": [
                    {"key": "page", "value": "0"},
                    {"key": "size", "value": "10"}
                  ]
                }
              }
            },
            {
              "name": "Get ticket category by ID",
              "description": "Retrieve a single ticket category by its ID.",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/admin/ticket-categories/1",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "ticket-categories", "1"]
                }
              }
            }
          ]
        },
        {
          "name": "Admin - Voucher Management (requires admin token)",
          "description": "Admin endpoints for managing promotional vouchers (create-only, no updates/deletes).",
          "item": [
            {
              "name": "Create voucher",
              "description": "Creates a new voucher. Fields:\n- `code`: unique string\n- `discountType`: `PERCENT` or `FIXED`\n- `discountValue`: number\n- `usageLimit`: total times usable (default 1)\n- `validFrom` / `validTo`: ISO 8601 timestamps\n- `minOrderValue`: minimum order total to apply (default 0)",
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"code\": \"SUMMER20\", \"discountType\": \"PERCENT\", \"discountValue\": 20, \"usageLimit\": 100, \"validFrom\": \"2025-01-01T00:00:00\", \"validTo\": \"2025-12-31T23:59:59\", \"minOrderValue\": 50}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/admin/vouchers",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "vouchers"]
                }
              }
            },
            {
              "name": "Get all vouchers (filtered)",
              "description": "Paginated list of vouchers with optional filters: code (partial), discountType, isValid (current validity), validFrom/To range.",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/admin/vouchers?code=FLASH&discountType=PERCENT&page=0&size=10",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "vouchers"],
                  "query": [
                    {"key": "code", "value": "FLASH"},
                    {"key": "discountType", "value": "PERCENT"},
                    {"key": "page", "value": "0"},
                    {"key": "size", "value": "10"}
                  ]
                }
              }
            },
            {
              "name": "Get voucher by ID",
              "description": "Retrieve a single voucher by its database ID.",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/admin/vouchers/1",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "vouchers", "1"]
                }
              }
            },
            {
              "name": "Get voucher by code",
              "description": "Retrieve a voucher by its unique code string.",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/admin/vouchers/code/FLASH10",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "vouchers", "code", "FLASH10"]
                }
              }
            }
          ]
        },
        {
          "name": "Admin - Booking Management (requires admin token)",
          "description": "Admin endpoints to view and update booking statuses.",
          "item": [
            {
              "name": "Get all bookings (admin filter)",
              "description": "Paginated list of all bookings (across all users). Filterable by status, userId, concertId, date range.",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/admin/bookings?status=PENDING&page=0&size=20",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "bookings"],
                  "query": [
                    {"key": "status", "value": "PENDING"},
                    {"key": "page", "value": "0"},
                    {"key": "size", "value": "20"}
                  ]
                }
              }
            },
            {
              "name": "Update booking status to PAID",
              "description": "Transition a `PENDING` booking to `PAID`. (Manual payment confirmation).",
              "request": {
                "method": "PUT",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/admin/bookings/1/status?status=PAID",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "bookings", "1", "status"],
                  "query": [{"key": "status", "value": "PAID"}]
                }
              }
            },
            {
              "name": "Update booking status to CANCELLED",
              "description": "Transition a `PENDING` booking to `CANCELLED`. Tickets will be released automatically.",
              "request": {
                "method": "PUT",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/admin/bookings/1/status?status=CANCELLED",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "bookings", "1", "status"],
                  "query": [{"key": "status", "value": "CANCELLED"}]
                }
              }
            }
          ]
        },
        {
          "name": "Admin - User Management (requires admin token)",
          "description": "Admin endpoints for managing users (create, list, update). Delete operations are not implemented.",
          "item": [
            {
              "name": "Create user (admin)",
              "description": "Creates a new user with specified role (`CUSTOMER`, `OPERATOR`, or `ADMIN`).",
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"email\": \"operator@geek.com\", \"name\": \"Operator\", \"password\": \"op123\", \"role\": \"OPERATOR\"}",
                  "options": {"raw": {"language": "json"}}
                },
                "url": {
                  "raw": "{{base_url}}/api/admin/users",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "users"]
                }
              }
            },
            {
              "name": "Get all users (filtered)",
              "description": "Paginated list of users with optional filters: email (partial), name (partial), role.",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/admin/users?role=ADMIN&page=0&size=10",
                  "host": ["{{base_url}}"],
                  "path": ["api", "admin", "users"],
                  "query": [
                    {"key": "role", "value": "ADMIN"},
                    {"key": "page", "value": "0"},
                    {"key": "size", "value": "10"}
                  ]
                }
              }
            },
            {
              "name": "Get user by ID",
              "description": "Retrieve user details by ID.",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text"}
                ],
                "url": {
